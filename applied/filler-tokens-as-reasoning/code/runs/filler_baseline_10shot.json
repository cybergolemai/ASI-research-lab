{
  "schema_version": 1,
  "paper": {
    "arxiv": "2607.22925",
    "title": "Not All LLM Reasoning is Visible in the Chain-of-Thought",
    "sections": ["4.1", "5.2", "A.2", "A.3", "A.4"],
    "table": "Table 1 counting-filler row; Figure 1 10-shot baseline"
  },
  "backend": "openrouter",
  "models": [
    "qwen/qwen3-235b-a22b-2507"
  ],
  "tasks": ["multiplication", "arithmetic"],
  "conditions": [
    { "name": "baseline", "filler_type": null },
    { "name": "counting_1_100", "filler_type": "counting", "filler_words": 100 }
  ],
  "notes": "Table 1 uses counting tokens 1-100, which Appendix A.4 says tokenizes to ~200 tokens across models, so the filler is specified by word count rather than token count. Use filler_tokens instead to reproduce the n-token sweep in Figure 1.",
  "shots": 10,
  "n_problems": 1000,
  "seed": 12345,
  "tokenizer": "tiktoken:o200k_base",
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 32,
    "reasoning": false
  },
  "prompting": {
    "prefill": true,
    "no_think": {
      "qwen/*": true
    }
  },
  "concurrency": 16,
  "max_samples": 200,
  "cache": "~/.cache/nanochat/filler_eval_cache.jsonl",
  "expected_from_paper": {
    "qwen/qwen3-235b-a22b-2507": {
      "multiplication": { "baseline": 69.6, "counting_1_100": 69.2, "delta": -0.4 },
      "arithmetic": { "baseline": 11.0, "counting_1_100": 9.7, "delta": -1.3 }
    }
  }
}
